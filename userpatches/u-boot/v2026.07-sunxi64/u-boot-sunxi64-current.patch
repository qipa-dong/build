diff --git a/dts/upstream/src/arm64/allwinner/sun50i-h313-x96q-min.dts b/dts/upstream/src/arm64/allwinner/sun50i-h313-x96q-min.dts
new file mode 100755
index 00000000000..20fb8d84f27
--- /dev/null
+++ b/dts/upstream/src/arm64/allwinner/sun50i-h313-x96q-min.dts
@@ -0,0 +1,328 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * X96Q (H313) 最小可启动设备树。
+ * 说明：
+ *  - 以 orangepi-zero2 的 RSB-PMIC 结构为骨架，PMIC 实测挂在 RSB 上
+ *    (内核日志: sunxi-rsb ... AXP20x variant AXP806 found)。
+ *  - 原 sun50i-h313-x96-q.dts 额外使能了 &r_i2c(TWI5，与 RSB 共用 PL0/PL1 引脚)
+ *    挂第二个 PMIC @0x36，与 RSB 抢线导致内核死在平台总线探测，这里已去掉。
+ *  - 仅保留启动必需项：串口 / SD / eMMC / RSB-PMIC。
+ *    其余（USB、SPI、以太网、LED、WiFi/BT）后续按需逐项加回。
+ */
+
+/dts-v1/;
+
+#include "sun50i-h616.dtsi"
+#include "sun50i-h616-cpu-opp.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+
+/ {
+	model = "Shenzhen Amediatech Technology Co., Ltd X96Q TV Box";
+	compatible = "amediatech,x96q", "allwinner,sun50i-h616";
+
+	aliases {
+		serial0 = &uart0;
+		mmc0 = &mmc0;
+		mmc2 = &mmc2;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	xtal32k: xtal32k {
+		/* 32.768kHz 时钟：PG10 mux 成 x32kfout 输出，供给 XR819 SDIO WiFi */
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+	};
+
+	reg_vcc5v: vcc5v {
+		/* 板级 5V，由 DC 电源输入 */
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-5v";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-always-on;
+	};
+
+	leds {
+		/* 板载双色状态灯（源自安卓 gpio_para 节点）：
+		 *   工作灯 PH6 = normal_led（蓝色，低电平点亮）
+		 *   待机灯 PH7 = standby_led（红色，高电平点亮）
+		 * 供电域 vcc-ph(reg_aldo1) 已在 &pio 中声明。 */
+		compatible = "gpio-leds";
+
+		led-normal {
+			label = "x96q:blue:status";
+			gpios = <&pio 7 6 GPIO_ACTIVE_LOW>;
+			default-state = "on";	/* 工作状态默认为蓝色常亮 */
+		};
+
+		led-standby {
+			label = "x96q:red:standby";
+			gpios = <&pio 7 7 GPIO_ACTIVE_HIGH>;
+			default-state = "off";	/* 待机灯默认熄灭 */
+		};
+	};
+
+	wifi_pwrseq: wifi_pwrseq {
+		/* XR819 上电：安卓实测 wlan_regon(PG18) out lo=使能，故低有效；
+		 * 需 PG10 复用 x32kfout 输出 32.768kHz(xtal32k/losc_out) 供芯片。 */
+		compatible = "mmc-pwrseq-simple";
+		clocks = <&xtal32k>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_32k_pins>;
+		reset-gpios = <&pio 6 18 GPIO_ACTIVE_LOW>;
+		post-power-on-delay-ms = <100>;
+	};
+};
+
+&cpu0 {
+	cpu-supply = <&reg_dcdca>;
+};
+
+&mmc0 {
+	/* microSD 卡槽，供电/检测脚与 orangepi-zero2 一致 */
+	vmmc-supply = <&reg_dcdce>;
+	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>;	/* PF6 */
+	disable-wp;
+	bus-width = <4>;
+	status = "okay";
+};
+
+&mmc2 {
+	/* 板载 eMMC：原厂只跑 DDR50@52MHz，HS200 实测会报 data error */
+	vmmc-supply = <&reg_aldo1>;
+	vqmmc-supply = <&reg_bldo1>;
+	non-removable;
+	mmc-ddr-1_8v;
+	max-frequency = <50000000>;
+	bus-width = <8>;
+	status = "okay";
+};
+
+&mmc1 {
+	/* SDIO WiFi：板上丝印 XR819 → xradio,xr819 驱动（非 sprdwl/UWE5622）。
+	 *
+	 * ---- 中断机制说明（重要） ----
+	 * XR819 使用 cap-sdio-irq（SDIO 数据线 in-band 中断）。
+	 * 该驱动在运行时会周期性打印 "xradio_wlan mmc3:0001:1: missed interrupt"，
+	 * 这是 xradio_wlan 驱动的固有行为，不影响扫描/连接/收发，可视为正常噪音。
+	 * 在 orangepi-zero2 标准 Armbian overlay 下同样出现，非本 dts 配置缺陷。
+	 *
+	 * 切勿改用 OOB GPIO 中断（如 PG15/wlan_hostwake）来消除该刷屏：
+	 * 曾尝试给 sdio@1 添加 interrupt-parent=<&pio> / interrupts=<6 15 IRQ_TYPE_LEVEL_LOW>，
+	 * 内核在该驱动 probe 阶段触发 NULL 指针 panic
+	 * (xradio_irq_handler -> __wake_up_common 解引用空指针)。此方案不可用。
+	 *
+	 * 压制刷屏的推荐方式：sysctl -w kernel.printk='3 4 1 3'（或 /etc/sysctl.d/ 持久化），
+	 * 保留 error 级别，屏蔽 warn/info。
+	 *
+	 * ---- 启动前置条件 ----
+	 * 1) mmc1 的 pinctrl(PG0-5)与 max-frequency 由 dtsi 内建，此处不重复。
+	 * 2) 需通过 wifi_pwrseq 提供 32k 时钟(见 wifi_pwrseq 与 wifi_32k_pins)。
+	 *    XR819 缺 32k 时钟会表现为 "Failed to initialize a non-removable card"，
+	 *    即 SDIO 卡完全无法枚举。PG10 复用 function 名是 "clock"(X32KFOUT)。
+	 * 3) vmmc 供电 reg_dcdce(3.3V)。 */
+	vmmc-supply = <&reg_dcdce>;
+	mmc-pwrseq = <&wifi_pwrseq>;
+	bus-width = <4>;
+	non-removable;
+	cap-sdio-irq;
+	status = "okay";
+
+	sdio@1 {
+		compatible = "xradio,xr819";
+		reg = <1>;
+	};
+};
+
+/* USB 控制器与板上物理口对照（实测 + 安卓日志核对）：
+ *   ehci0/ohci0 (5101000/5101400) = 物理 USB-A 口1
+ *   ehci3/ohci3 (5311000/5311400) = 物理 USB-A 口2
+ *   ehci1/ohci1 (5200000) 与 ehci2/ohci2 (5310000) 无外壳口走线（空挂），
+ *   保留 enabled 与安卓一致，仅占一个 roothub，不插设备不进中断。
+ */
+&usbotg {
+	dr_mode = "host";
+	status = "okay";
+};
+
+&ehci0 {
+	status = "okay";
+};
+
+&ehci1 {
+	/* 板级未引线到外壳，保持可用无副作用 */
+	status = "okay";
+};
+
+&ehci2 {
+	/* 板级未引线到外壳，保持可用无副作用 */
+	status = "okay";
+};
+
+/* 第 4 个 EHCI/OHCI：物理口2 归属 sunxi-ehci(安卓 usb 4-1)。
+ * 此前只开了 ehci0/1/2，缺这个导致口2 完全静默。 */
+&ehci3 {
+	status = "okay";
+};
+
+&ohci0 {
+	status = "okay";
+};
+
+&ohci1 {
+	status = "okay";
+};
+
+&ohci2 {
+	status = "okay";
+};
+
+&ohci3 {
+	status = "okay";
+};
+
+&usbphy {
+	usb0_vbus-supply = <&reg_vcc5v>;
+	usb1_vbus-supply = <&reg_vcc5v>;
+	usb2_vbus-supply = <&reg_vcc5v>;
+	usb3_vbus-supply = <&reg_vcc5v>;
+	status = "okay";
+};
+
+&r_rsb {
+	status = "okay";
+
+	axp305: pmic@745 {
+		compatible = "x-powers,axp305", "x-powers,axp805",
+			     "x-powers,axp806";
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		reg = <0x745>;
+
+		x-powers,self-working-mode;
+		vina-supply = <&reg_vcc5v>;
+		vinb-supply = <&reg_vcc5v>;
+		vinc-supply = <&reg_vcc5v>;
+		vind-supply = <&reg_vcc5v>;
+		vine-supply = <&reg_vcc5v>;
+		aldoin-supply = <&reg_vcc5v>;
+		bldoin-supply = <&reg_vcc5v>;
+		cldoin-supply = <&reg_vcc5v>;
+
+		regulators {
+			reg_aldo1: aldo1 {
+				regulator-always-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vcc-sys";
+			};
+
+			reg_aldo2: aldo2 {
+				regulator-always-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vcc3v3-ext";
+			};
+
+			reg_aldo3: aldo3 {
+				regulator-always-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vcc3v3-ext2";
+			};
+
+			reg_bldo1: bldo1 {
+				regulator-always-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = "vcc1v8";
+			};
+
+			bldo2 {
+				/* unused */
+			};
+
+			bldo3 {
+				/* unused */
+			};
+
+			bldo4 {
+				/* unused */
+			};
+
+			cldo1 {
+				/* reserved */
+			};
+
+			cldo2 {
+				/* unused */
+			};
+
+			cldo3 {
+				/* unused */
+			};
+
+			reg_dcdca: dcdca {
+				regulator-always-on;
+				regulator-min-microvolt = <810000>;
+				regulator-max-microvolt = <1200000>;
+				regulator-name = "vdd-cpu";
+			};
+
+			reg_dcdcc: dcdcc {
+				regulator-always-on;
+				regulator-min-microvolt = <810000>;
+				regulator-max-microvolt = <990000>;
+				regulator-name = "vdd-gpu-sys";
+			};
+
+			reg_dcdcd: dcdcd {
+				regulator-always-on;
+				regulator-min-microvolt = <1500000>;
+				regulator-max-microvolt = <1500000>;
+				regulator-name = "vdd-dram";
+			};
+
+			reg_dcdce: dcdce {
+				regulator-always-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vcc-eth-mmc";
+			};
+
+			sw {
+				/* unused */
+			};
+		};
+	};
+};
+
+&pio {
+	vcc-pc-supply = <&reg_aldo1>;
+	vcc-pd-supply = <&reg_aldo1>;
+	vcc-pg-supply = <&reg_aldo1>;
+	vcc-ph-supply = <&reg_aldo1>;
+	vcc-pi-supply = <&reg_aldo1>;
+
+	/* PG10 复用为 clock(X32KFOUT)：向 XR819 输出 32.768kHz 慢时钟
+	 * （H616 pinctrl 驱动注册名是 "clock"，非 "x32kfout"） */
+	wifi_32k_pins: wifi-32k-pins {
+		pins = "PG10";
+		function = "clock";
+	};
+};
+
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0_ph_pins>;
+	status = "okay";
+};
+
+
